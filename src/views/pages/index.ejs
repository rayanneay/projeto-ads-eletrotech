<%- include('../partials/head.ejs') %>
<%- include('../partials/header.ejs') %>

<!--
    Dados que se repetem com o mesmo HTML (usados nos loops abaixo)
-->

<%
const slidesPadrao = [ // Slides do carrossel do banner
    {
        img: '/images/materiais1.jpg',
        title: 'Eletrotech',
        subtitle: 'Soluções elétricas',
        btn_text: 'Conheça as soluções →',
        link: '/servicos-e-produtos'
    },
    {
        img: '/images/motores.jpg',
        title: 'OxilifeFish',
        subtitle: 'Tecnologia para piscicultura',
        btn_text: 'Conheça o OxilifeFish →',
        link: '/oxilifefish'
    },
    {
        img: '/images/painel.jpg',
        title: 'Painéis elétricos',
        subtitle: 'Montagem e automação',
        btn_text: 'Conheça as soluções →',
        link: '/servicos-e-produtos'
    },
    {
        img: '/images/painelsonda.jpg',
        title: 'Sonda OxilifeFish',
        subtitle: 'Controle para a piscicultura',
        btn_text: 'Conheça o OxilifeFish →',
        link: '/oxilifefish'
    }   
]

const slides = [
    ...slidesPadrao,
    ...promotions.map(promotion => ({
        img: promotion.imageUrl,
        title: promotion.title,
        subtitle: promotion.description,
        btn_text: promotion.buttonText,
        link: promotion.buttonUrl
    }))
]

const cards = [ // Cards da seção de serviços e produtos
    {
        img: '/images/card-solucoes-eletricas.png',
        title: 'Soluções Elétricas',
        text: 'Materiais e soluções para instalações e painéis elétricos, com qualidade e confiabilidade para sua operação.',
        btn_text: 'Conheça nossas soluções',
        link: '/servicos-e-produtos'
    },
    {
        img: '/images/card-piscicultura.png',
        title: 'Tecnologia para Piscicultura',
        text: 'Materiais e soluções para instalações e painéis elétricos, com qualidade e confiabilidade para sua operação.',
        btn_text: 'Conheça o OxilifeFish',
        link: '/oxilifefish'
    },
    {
        img: '/images/card-componentes-eletricos.png',
        title: 'Componentes Elétricos',
        text: 'Materiais e soluções para instalações e painéis elétricos, com qualidade e confiabilidade para sua operação.',
        btn_text: 'Ver produtos',
        link: '/servicos-e-produtos'
    }
]

const content_box_others = [ // Blocos de texto da seção "Sobre a Eletrotech"
    {
        title: 'DESDE 2018',
        text: 'Experiência e evolução'
    },
    {
        title: 'ATENDIMENTO ESPECIAL',
        text: 'Inclusive fora do horário comercial'
    },
    {
        title: 'SOLUÇÕES COMPLETAS',
        text: 'Elétrica, automação e manutenção'
    }
]

const icon_contato = [ // Ícones da seção de contato
    {
        icon: 'fa-solid fa-headset fa-2xl',
        text: 'Atendimento especializado'
    },
    {
        icon: 'fa-solid fa-gear fa-2xl',
        text: 'Soluções personalizadas'
    },
    {
        icon: 'fa-solid fa-clock fa-2xl',
        text: 'Resposta rápida'
    }
]
%>



<main class="inicio-main">



    <section class="inicio-banner">

        <% slides.forEach((slide, i) => { %>

            <div class="banner-slide <%= i === 0 ? 'active' : '' %>" style="background-image: url('<%= slide.img %>')">

                <div class="banner-text-box">
                    <p class="banner-title"><%= slide.title %></p>
                    <p class="banner-subtitle"><%= slide.subtitle %></p>
                </div>

                <a href="<%= slide.link %>" class="btn btn-outline"><%= slide.btn_text %></a>

            </div>

        <% }) %>

        <button class="banner-seta banner-seta-anterior" type="button" aria-label="Slide anterior">‹</button>
        <button class="banner-seta banner-seta-proxima" type="button" aria-label="Próximo slide">›</button>

        <div class="banner-dots">
            <% slides.forEach((slide, i) => { %>
                <button class="banner-dot <%= i === 0 ? 'active' : '' %>" type="button" aria-label="Ir para o slide <%= i + 1 %>"></button>
            <% }) %>
        </div>

    </section>


    <section class="inicio-oxilifefish">

        <img class="oxilifefish-icon" src="/images/oxilifefish-logo.png" alt="OxilifeFish" />
        <hr />
        <span>Mais controle. Mais segurança. Mais produtividade.</span>
        <a href="/oxilifefish" class="btn btn-outline">Conheça</a>

    </section>


    <section class="inicio-produtos">

        <h2 class="produtos-title">Por que escolher a Eletrotech?</h2>

        <div class="produtos-card-box">

            <% cards.forEach(card => { %>

                <div class="produtos-card">

                    <img class="produtos-card-img" src="<%= card.img %>" alt="<%= card.title %>" />

                    <div class="produtos-card-text-box">
                        <h3 class="produtos-card-title"><%= card.title %></h3>
                        <p class="produtos-card-text"><%= card.text %></p>
                    </div>

                    <a class="produtos-card-button" href="<%= card.link %>"><%= card.btn_text %></a>

                </div>

            <% }) %>

        </div>

    </section>


    <section class="inicio-sobre">

        <h2 class="sobre-title">Sobre a Eletrotech</h2>

        <div class="sobre-content-box">

            <div class="sobre-content-box-first">

                <h3 class="sobre-content-box-first-title">Soluções que evoluem com a sua necessidade.</h3>
                <p class="sobre-content-box-first-text">Desde 2018, atuamos com soluções elétricas, automação e manutenção, unindo qualidade, tecnologia e compromisso em cada projeto.</p>
                <a href="/sobre-nos" class="btn btn-outline">Nossa História →</a>

            </div>

            <% content_box_others.forEach(content_box => { %>

                <div class="sobre-content-box-others">

                    <h3 class="sobre-content-box-others-title"><%= content_box.title %></h3>
                    <p class="sobre-content-box-others-text"><%= content_box.text %></p>

                </div>

            <% }) %>

        </div>

    </section>



    <!-- ================= CONTATO ================= -->
    <section class="inicio-contato">

        <div class="contato-content-box">

            <div class="contato-content-text-box">

                <h2 class="contato-contato-title">Precisando de uma solução?</h2>
                <p class="contato-contato-text">Entre em contato conosco pelo whatsapp!</p>

            </div>

            <div class="contato-content-btn-box">

                <a href="/contato" class="btn btn-laranja btn-grande">Fale com a gente →</a>

            </div>

            <hr>

            <div class="contato-content-icon-box">

                <% icon_contato.forEach(item => { %>

                    <div class="contato-content-icon">

                        <i class="<%= item.icon %>"></i>
                        <span class="contato-content-icon-text"><%= item.text %></span>

                    </div>

                <% }) %>

            </div>

        </div>

    </section>



</main>



<%- include('../partials/footer.ejs') %>
<%- include('../partials/scripts.ejs') %>
