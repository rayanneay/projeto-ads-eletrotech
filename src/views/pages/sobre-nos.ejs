<%
    // Ícones (SVG de traço). Para trocar o ícone de um evento, use outro nome em "icone".
    const icones = {
        casa: '<path d="M3 11l9-8 9 8"/><path d="M5 10v11h14V10"/><path d="M10 21v-6h4v6"/>',
        documento: '<path d="M6 2h8l5 5v15H6z"/><path d="M14 2v5h5"/>',
        ajustes: '<path d="M4 7h10M18 7h2M4 17h2M10 17h10"/><circle cx="16" cy="7" r="2"/><circle cx="8" cy="17" r="2"/>',
        celular: '<rect x="7" y="2" width="10" height="20" rx="2"/><path d="M11 18h2"/>',
        local: '<path d="M12 21s-7-6.2-7-11a7 7 0 0114 0c0 4.8-7 11-7 11z"/><circle cx="12" cy="10" r="2.5"/>',
        carrinho: '<path d="M2 3h3l2.5 12h11l2-8H6"/><circle cx="9" cy="20" r="1.5"/><circle cx="17" cy="20" r="1.5"/>',
        maleta: '<rect x="3" y="7" width="18" height="13" rx="2"/><path d="M9 7V4h6v3M3 13h18"/>',
        livro: '<path d="M2 4h7a3 3 0 013 3v14a2 2 0 00-2-2H2z"/><path d="M22 4h-7a3 3 0 00-3 3v14a2 2 0 012-2h8z"/>',
        escudo: '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/>',
        check: '<rect x="3" y="3" width="18" height="18" rx="3"/><path d="M8 12l3 3 5-6"/>'
    };

    const valores = [
        { icone: 'maleta', titulo: 'Qualidade', texto: 'Equipamentos de nível industrial e serviço feito com excelência.' },
        { icone: 'livro', titulo: 'Inovação', texto: 'Automação e controle pelo celular, como na sonda OxilifeFish.' },
        { icone: 'escudo', titulo: 'Segurança', texto: 'Alarmes e acionamentos confiáveis, para o produtor trabalhar tranquilo.' },
        { icone: 'check', titulo: 'Compromisso', texto: 'Prazo combinado é prazo cumprido, até fora do horário comercial.' }
    ];

    // Linha do tempo: deixe "data" vazio ('') para não exibir a data.
    const linhaDoTempo = [
        { data: 'Agosto de 2018', titulo: 'O Início', icone: 'casa',
          texto: 'Começamos com rebobinagem e manutenção de motores elétricos e bombas d\'água, além de serviços elétricos básicos.' },
        { data: '', titulo: 'Projetos elétricos', icone: 'documento',
          texto: 'Passamos a montar painéis elétricos e a atender projetos elétricos na área industrial.' },
        { data: '', titulo: 'Automação', icone: 'ajustes',
          texto: 'Ampliamos para automação industrial e instalação de equipamentos liga/desliga, com controle também pelo celular.' },
        { data: '', titulo: 'OxilifeFish', icone: 'celular',
          texto: 'Desenvolvemos a sonda que monitora e controla o oxigênio em tanques de peixe, com acesso remoto pelo aplicativo.' },
        { data: '', titulo: 'Atendimento na região', icone: 'local',
          texto: 'Atendemos todo o oeste do Paraná, inclusive fora do horário comercial, com visita técnica no mesmo dia sempre que possível.' },
        { data: '', titulo: 'Produtos', icone: 'carrinho',
          texto: 'Passamos a oferecer produtos Zagonel, motores Hércules e materiais para painéis e instalações elétricas.' }
    ];
%>
<%- include('../partials/head.ejs') %>
<%- include('../partials/header.ejs') %>

    <main class="empresa-main">

        <!-- Quem somos -->
        <section class="emp-hero">
            <div class="emp-hero-texto">
                <h1 class="emp-titulo">Quem <span class="emp-destaque">Somos</span></h1>
                <p>
                    A Eletrotech Marechal - Sistemas Elétricos nasceu em agosto de 2018, em Marechal Cândido Rondon,
                    com rebobinagem e manutenção de motores elétricos e bombas d'água. Com o tempo, passamos a atender
                    também automação e projetos elétricos industriais.
                </p>
                <p>
                    Hoje atendemos indústria, piscicultura e residências em todo o oeste do Paraná,
                    com um diferencial: atendimento fora do horário comercial, inclusive de madrugada.
                </p>
                <a class="btn btn-laranja" href="/servicos-e-produtos">Conheça nossos serviços +</a>
            </div>
            <svg class="emp-raio" viewBox="0 0 100 160" aria-hidden="true">
                <path d="M62 0L8 92h38L32 160l60-100H54z"/>
            </svg>
        </section>

        <!-- O que nos move -->
        <section class="emp-valores">
            <div class="emp-valores-topo">
                <h2>O que nos <span class="emp-laranja">move</span></h2>
                <a href="/oxilifefish" aria-label="Conheça o OxilifeFish">
                    <img src="/images/oxilifefish-logo.png" alt="OxilifeFish">
                </a>
            </div>
            <ul class="emp-valores-lista">
                <% valores.forEach(v => { %>
                    <li>
                        <svg viewBox="0 0 24 24" aria-hidden="true"><%- icones[v.icone] %></svg>
                        <h3><%= v.titulo %></h3>
                        <p><%= v.texto %></p>
                    </li>
                <% }) %>
            </ul>
        </section>

        <!-- Nossa história -->
        <section class="emp-historia">
            <h2 class="emp-titulo emp-centro">Nossa <span class="emp-destaque">História</span></h2>
            <p class="emp-historia-intro">
                Em oito anos, saímos da rebobinagem de motores para painéis elétricos, automação
                e o desenvolvimento da sonda OxilifeFish. Veja como chegamos até aqui.
            </p>

            <ol class="emp-timeline">
                <% linhaDoTempo.forEach(ev => { %>
                    <li class="emp-evento">
                        <article class="emp-evento-card">
                            <svg viewBox="0 0 24 24" aria-hidden="true"><%- icones[ev.icone] %></svg>
                            <div class="emp-evento-texto">
                                <% if (ev.data) { %><time><%= ev.data %></time><% } %>
                                <h3><%= ev.titulo %></h3>
                                <p><%= ev.texto %></p>
                            </div>
                        </article>
                    </li>
                <% }) %>
            </ol>
        </section>

    </main>

<%- include('../partials/footer.ejs') %>
<%- include('../partials/scripts.ejs') %>
