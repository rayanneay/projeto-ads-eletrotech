                    </div>
                    <h2>Onde Estamos</h2>
                    <address>
                        R. Darley Germano Bregolli, 513<br>
                        Vila Gaúcha — Marechal Cândido Rondon - PR<br><br>
                        CEP 85960-000
                    </address>
                    <a class="contato-mapa-link" target="_blank" rel="noopener"
                       href="https://www.google.com/maps/search/?api=1&query=R.+Darley+Germano+Bregolli,+513,+Marechal+C%C3%A2ndido+Rondon,+PR">
                        Ver no Google Maps
                    </a>
                </div>
                <iframe class="contato-mapa" title="Mapa da Eletrotech Marechal" loading="lazy"
                    referrerpolicy="no-referrer-when-downgrade"
                    src="https://www.google.com/maps?q=R.+Darley+Germano+Bregolli,+513,+Marechal+C%C3%A2ndido+Rondon,+PR&output=embed"></iframe>
